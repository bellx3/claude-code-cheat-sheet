"""
Claude Code to Ollama 프록시 서버
==================================

이 프록시 서버는 Claude Code와 Ollama 사이의 미들웨어 역할을 하며,
서로 다른 두 API 형식 간의 요청/응답을 변환해 줍니다.

Author: Joe Njenga
목적: Claude Code가 로컬 Ollama 모델(특히 GPT-OSS)과 함께 동작하도록 지원
Article : https://medium.com/@joe.njenga/how-i-tricked-claude-code-to-use-gpt-oss-the-new-openai-model-it-worked-5b7ee0483c22
License: MIT

주요 기능:
- Claude API 요청을 Ollama 형식으로 변환
- Ollama 응답을 다시 Claude API 형식으로 변환
- 스트리밍 및 비스트리밍 요청 모두 지원
- 로컬 모델용 인증 우회 처리
- 헬스 체크 엔드포인트 제공

요구 사항:
- Python 3.7+
- Flask
- Requests
- GPT-OSS 모델로 로컬에서 실행 중인 Ollama

사용법:
1. Ollama 실행: `ollama serve`
2. 모델 다운로드: `ollama pull gpt-oss:20b`
3. 프록시 실행: `python claude_ollama_proxy.py`
4. Claude Code가 http://localhost:8000 을 base URL로 사용하도록 설정

환경 변수:
- ANTHROPIC_API_KEY="dummy-key" (Claude Code에서 필수로 요구함)
- ANTHROPIC_BASE_URL="http://localhost:8000" (이 프록시를 가리킴)

엔드포인트:
- POST /v1/messages - 메인 메시지 엔드포인트 (스트리밍 지원)
- GET /v1/models - 사용 가능한 모델 목록 조회
- GET /health - 헬스 체크

참고: 이 프록시는 실제로는 로컬 Ollama 인스턴스와 통신하면서도,
Claude Code가 마치 Claude와 대화하는 것처럼 착각하게 만듭니다.
"""

from flask import Flask, request, jsonify, Response
import requests
import json
import time
from typing import Dict, Any

app = Flask(__name__)

# 설정
OLLAMA_BASE_URL = "http://localhost:11434"
OLLAMA_MODEL = "gpt-oss:20b"  # 사용할 모델로 변경하세요

class ClaudeOllamaProxy:
    def __init__(self):
        self.conversation_history = {}
    
    def claude_to_ollama_format(self, claude_request: Dict[str, Any]) -> Dict[str, Any]:
        """Claude API 요청을 Ollama 형식으로 변환"""

        messages = claude_request.get('messages', [])
        ollama_messages = []

        for msg in messages:
            role = msg.get('role', 'user')
            content = msg.get('content', '')

            # Claude의 content 형식 처리 (문자열일 수도, 리스트일 수도 있음)
            if isinstance(content, list):
                text_content = ""
                for block in content:
                    if block.get('type') == 'text':
                        text_content += block.get('text', '')
                content = text_content
            
            ollama_messages.append({
                "role": role,
                "content": content
            })
        
        return {
            "model": OLLAMA_MODEL,
            "messages": ollama_messages,
            "stream": claude_request.get('stream', False)
        }
    
    def ollama_to_claude_format(self, ollama_response: Dict[str, Any]) -> Dict[str, Any]:
        """Ollama 응답을 Claude API 형식으로 변환"""
        
        if 'message' in ollama_response:
            content = ollama_response['message'].get('content', '')
            
            return {
                "id": f"msg_{int(time.time())}",
                "type": "message",
                "role": "assistant",
                "content": [
                    {
                        "type": "text",
                        "text": content
                    }
                ],
                "model": "claude-3-sonnet-20240229",  # Mimic Claude
                "stop_reason": "end_turn",
                "stop_sequence": None,
                "usage": {
                    "input_tokens": 0,
                    "output_tokens": 0
                }
            }
        
        return ollama_response

def handle_streaming_request(ollama_request: Dict[str, Any], proxy: ClaudeOllamaProxy):
    """Claude Code로부터의 스트리밍 요청 처리"""
    def generate_claude_stream():
        try:
            # Ollama로 스트리밍 요청 전송
            response = requests.post(
                f"{OLLAMA_BASE_URL}/api/chat",
                json=ollama_request,
                stream=True,
                timeout=120  # 대형 모델을 위해 타임아웃 증가
            )
            response.raise_for_status()

            # 초기 message_start 이벤트 전송
            yield f"data: {json.dumps({'type': 'message_start'})}\n\n"

            # Ollama의 스트리밍 응답 처리
            for line in response.iter_lines():
                if line:
                    try:
                        ollama_chunk = json.loads(line.decode('utf-8'))

                        # 마지막 청크인지 확인
                        if ollama_chunk.get('done', False):
                            # Claude 형식으로 최종 청크 전송
                            yield f"data: {json.dumps({'type': 'message_stop'})}\n\n"
                            break

                        # 스트리밍 청크를 Claude 형식으로 변환
                        if 'message' in ollama_chunk:
                            content = ollama_chunk['message'].get('content', '')
                            if content:
                                claude_chunk = {
                                    "type": "content_block_delta",
                                    "index": 0,
                                    "delta": {
                                        "type": "text_delta",
                                        "text": content
                                    }
                                }
                                yield f"data: {json.dumps(claude_chunk)}\n\n"
                    
                    except json.JSONDecodeError:
                        continue
                        
        except requests.exceptions.RequestException as e:
            error_chunk = {
                "type": "error",
                "error": {
                    "type": "api_error",
                    "message": f"Ollama request failed: {str(e)}"
                }
            }
            yield f"data: {json.dumps(error_chunk)}\n\n"
    
    return Response(
        generate_claude_stream(),
        mimetype='text/event-stream',
        headers={
            'Cache-Control': 'no-cache',
            'Connection': 'keep-alive',
            'X-Accel-Buffering': 'no'
        }
    )

@app.route('/v1/messages', methods=['POST'])
def handle_messages():
    """Claude Code가 호출하는 메인 엔드포인트"""
    try:
        claude_request = request.get_json()
        proxy = ClaudeOllamaProxy()

        # 요청 형식 변환
        ollama_request = proxy.claude_to_ollama_format(claude_request)

        # 스트리밍/비스트리밍 분기 처리
        if ollama_request.get('stream', False):
            return handle_streaming_request(ollama_request, proxy)
        else:
            return handle_non_streaming_request(ollama_request, proxy)
            
    except Exception as e:
        return jsonify({"error": str(e)}), 500

def handle_non_streaming_request(ollama_request: Dict[str, Any], proxy: ClaudeOllamaProxy):
    """일반(비스트리밍) 요청 처리"""
    try:
        response = requests.post(
            f"{OLLAMA_BASE_URL}/api/chat",
            json=ollama_request,
            timeout=120  # 대형 모델을 위해 타임아웃 증가
        )
        response.raise_for_status()
        
        ollama_response = response.json()
        claude_response = proxy.ollama_to_claude_format(ollama_response)
        
        return jsonify(claude_response)
        
    except requests.exceptions.RequestException as e:
        return jsonify({"error": f"Ollama request failed: {str(e)}"}), 500

@app.route('/v1/models', methods=['GET'])
def list_models():
    """사용 가능한 모델 목록 반환 (Claude API를 모방)"""
    return jsonify({
        "data": [
            {
                "id": "claude-3-sonnet-20240229",
                "object": "model",
                "created": int(time.time()),
                "owned_by": "anthropic"
            }
        ]
    })

@app.route('/health', methods=['GET'])
def health_check():
    """헬스 체크 엔드포인트"""
    try:
        response = requests.get(f"{OLLAMA_BASE_URL}/api/tags", timeout=5)
        if response.status_code == 200:
            models = response.json().get('models', [])
            model_names = [model.get('name', '') for model in models]
            return jsonify({
                "status": "healthy", 
                "ollama": "connected",
                "available_models": model_names,
                "using_model": OLLAMA_MODEL
            })
        else:
            return jsonify({"status": "unhealthy", "ollama": "disconnected"}), 500
    except Exception as e:
        return jsonify({
            "status": "unhealthy", 
            "ollama": "unreachable",
            "error": str(e)
        }), 500

if __name__ == "__main__":
    print("=" * 60)
    print("Claude Code → Ollama Proxy Server")
    print("=" * 60)
    print(f"Ollama URL: {OLLAMA_BASE_URL}")
    print(f"Using model: {OLLAMA_MODEL}")
    print("Proxy running on http://localhost:8000")
    print("\nEndpoints:")
    print("  POST /v1/messages - Main Claude Code endpoint")
    print("  GET  /v1/models   - List models")
    print("  GET  /health      - Health check")
    print("\nMake sure to set these environment variables:")
    print('  ANTHROPIC_API_KEY="dummy-key"')
    print('  ANTHROPIC_BASE_URL="http://localhost:8000"')
    print("=" * 60)
    
    app.run(host='0.0.0.0', port=8000, debug=True)