{#- 이름 열에 세울 것과 아닌 것을 가른다. 둘 다 이름 열을 쓰지 않고 판을 가로질러 눕힌다
    (.item-line). 안 그러면 이런 항목 하나가 그 카드의 이름 열 폭을 정해 나머지 행을 전부
    멀리 밀어낸다.
    ① 이름이 34자를 넘으면 이름이 아니라 한 줄짜리 명령이다(101개 = 14.2%,
       `curl -fsSL … | bash` 같은 것들). 34자인 이유: 진짜 이름 중 가장 긴
       --dangerously-skip-permissions(30자)는 열에 남겨야 한다.
    ② 설명 칸에 아무것도 없는 항목(46개)은 그 문장 자체가 내용이다 — 레거시 이관에서
       term 과 desc 에 같은 문장이 들어가 있던 것들이고, 2026-08-21 에 desc 를 지웠다.
       같은 값이 다시 들어오면 G6 이 빌드를 세운다. -#}
{%- set longTerm = it.term and (it.term | trim | length) > 34 %}
{%- set bareTerm = it.term and not it.desc and not it.detail and not it.code and not it.example and not it.caveat %}
<article class="item{% if longTerm or bareTerm %} item-line{% endif %}" id="{{ it.anchor }}">
  <a class="anchor" href="#{{ it.anchor }}" aria-label="이 항목 링크">#</a>
  {%- if it.tone %}
  <span class="badge warn">{{ "위험" if it.tone == "danger" else "주의" }}</span>
  {%- endif %}
  {%- if it.term and not it.tone and not sameNameDesc %}
    {%- if it.term | hasHangul %}
  <span class="term term-label">{{ it.term }}</span>
    {%- else %}
  <code class="term">{{ it.term }}</code>
    {%- endif %}
  {%- endif %}
  {%- if it.desc %}
  <p class="{{ 'caveat' if it.tone else 'desc' }}">{{ it.desc }}</p>
  {%- endif %}
  {%- if it.detail %}
  <div class="detail">{{ it.detail | md | safe }}</div>
  {%- endif %}
  {%- if it.code %}
  <pre><code>{{ it.code }}</code></pre>
  {%- endif %}
  {%- if it.example %}
  <pre><code>{{ it.example }}</code></pre>
  {%- endif %}
  {%- if it.caveat and not it.tone %}
  <p class="caveat">{{ it.caveat | mdInline | safe }}</p>
  {%- endif %}
  {%- set linkedTasks = taskIndex.all | tasksOf(it.tasks) %}
  {%- if linkedTasks.length or it.see_also.length %}
  <p class="seealso">
    {%- for t in linkedTasks %}<a href="{{ t.url }}">→ {{ t.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    {%- if linkedTasks.length and it.see_also.length %} · {% endif %}
    {%- for r in it.see_also %}{% set target = refIndex.byRef[r] %}{% if target %}<a href="{{ target.url }}">{{ target.term }}</a>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
  </p>
  {%- endif %}
</article>
